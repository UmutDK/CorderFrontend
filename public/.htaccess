# Configuration Apache pour l'hébergement cPanel (copiée à la racine du build par Angular).
# Le site est une application Angular : toute URL qui n'est ni un fichier ni un dossier réel
# est renvoyée vers index.html, et c'est le routeur Angular qui affiche la bonne page.

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # HTTPS obligatoire
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # L'API PHP (public_html/api) a son propre .htaccess : on n'y touche pas
  RewriteRule ^api(/|$) - [L]

  # Fichiers et dossiers réels servis tels quels
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fichier manquant avec extension (image, script…) : vraie 404 plutôt que la page d'accueil
  RewriteCond %{REQUEST_URI} \.[a-zA-Z0-9]{2,5}$
  RewriteRule ^ - [R=404,L]

  # Tout le reste → application Angular
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # index.html jamais en cache : chaque déploiement est visible tout de suite
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Fichiers du build avec empreinte dans le nom (main-ABC123.js) : cache long
  <FilesMatch "-[A-Z0-9]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Données d'exemple (mode mock) : toujours revalider
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>
